# Auto-loaded by direnv when you cd into this repo (and unloaded when you leave).
#
# Points Swift Cloud (and the Pulumi it runs), Soto, the AWS CLI and the AWS MCP
# server at the sports-home-automation account. The profile is an IAM Identity
# Center profile in ~/.aws/config; sign in once with:
#
#   aws sso login --sso-session ryantoken
#
# No access keys belong in this repo. Swift Cloud also reads a .env file and lets
# it override the environment, so keep AWS credentials out of .env.
export AWS_PROFILE=sports-home-automation

# Soto's SSO credential provider ignores AWS_PROFILE and reads the [default]
# profile (the personal account), so Swift Cloud would keep its state there while
# Pulumi deploys here. Exporting the profile's short-lived SSO credentials as
# environment variables makes Soto, Pulumi and the AWS CLI all use this account.
# They last as long as the SSO role session (12 hours); after they expire, or
# after a fresh `aws sso login`, run `direnv reload`.
if aws_credentials=$(aws configure export-credentials --profile "$AWS_PROFILE" --format env 2>/dev/null); then
  eval "$aws_credentials"
else
  log_error "No AWS credentials for $AWS_PROFILE. Run 'aws sso login --sso-session ryantoken', then 'direnv reload'."
fi
unset aws_credentials

# Everything in this project runs in us-east-1 (see CLAUDE.md).
export AWS_REGION=us-east-1
export AWS_DEFAULT_REGION=us-east-1
